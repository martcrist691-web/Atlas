# ============================================================
#  ATLAS — Agente Editorial da Curadoria Prime
#  Copie este arquivo para ".env" e preencha os valores.
# ============================================================

# URL do site analisado
SITE_URL=https://curadoriaprime.com

# ------------------------------------------------------------
# PROVEDOR DE IA: escolha UM
#   "ollama" -> IA local, grátis, sem chave (precisa instalar o Ollama)
#   "openai" -> qualquer API compatível com OpenAI
#               (OpenAI, Groq, DeepSeek, Gemini, OpenRouter...)
# ------------------------------------------------------------
LLM_PROVIDER=ollama

# --- Opção 1: Ollama (local) --------------------------------
# Instale em https://ollama.com e rode:  ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Opção 2: API compatível com OpenAI ---------------------
# Exemplos de LLM_BASE_URL:
#   OpenAI:      https://api.openai.com/v1
#   Groq:        https://api.groq.com/openai/v1
#   DeepSeek:    https://api.deepseek.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# WORDPRESS (só necessário para publicar/atualizar artigos)
# No painel do WP: Usuários -> Perfil -> "Senhas de Aplicação"
# ------------------------------------------------------------
WP_USER=
WP_APP_PASSWORD=

# ------------------------------------------------------------
# OPCIONAL: pesquisa web real na etapa de pesquisa de produto
# Crie uma chave grátis em https://tavily.com
# (sem chave, o agente usa só o conhecimento do modelo de IA)
# ------------------------------------------------------------
TAVILY_API_KEY=
